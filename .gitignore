# Except the report figures: these are the actual publication-ready
# outputs of report_builders/make_figure_*.py, meant to be tracked.
!Practical_Examples/report_builders/figures/*.png

# Except the paper's own figures: extracted from the Report's .docx
# (word/media/*.png) and referenced directly by paper/main.tex -- needed
# for the paper to actually compile, not generated/regenerable output.
!paper/figures/*.png

# paper/main.docx is a pandoc-generated Word copy of paper/main.tex (for
# sharing/review), regenerated on demand -- a build artifact like
# paper/main.pdf, not tracked source. Unlike the real report deliverables
# under advisor_feedback/, which stay tracked.
paper/main.docx

